{
  "name": "duskline",
  "version": "0.1.0",
  "private": true,
  "description": "Duskline: a tower-climbing card game, built for the web first, then iOS and Android.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @duskline/web dev",
    "build": "pnpm --filter @duskline/web build",
    "preview": "pnpm --filter @duskline/web preview",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "sim": "pnpm --filter @duskline/sim sim",
    "e2e": "pnpm --filter @duskline/e2e e2e",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "build:site": "pnpm --filter @duskline/web build:site"
  }
}
